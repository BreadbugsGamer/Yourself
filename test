<!DOCTYPE html>
<html>
<head>
    <title>Console</title>

    <style>
        body {
            margin: 0;
            background: #000;
            color: #00ff66;
            font-family: "Courier New", monospace;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .console {
            width: 90%;
            max-width: 1000px;
            font-size: 28px;
            text-shadow: 0 0 8px #00ff66;
        }

        .text::after {
            content: "_";
            animation: blink 0.8s infinite;
        }

        @keyframes blink {
            0%, 50% {
                opacity: 1;
            }

            51%, 100% {
                opacity: 0;
            }
        }
    </style>
</head>

<body>

    <div class="console">
        <div class="text">WAITING</div>
    </div>

</body>
</html>
